  m_LocaleId:
    m_Code: ko-KR
  m_SharedData: {fileID: 11400000, guid: aa000000000000000000000000000002, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 3000000000000
    m_Localized: "\uAC8C\uC784\uC758 \uAE30\uBCF8\uC801\uC778 \uC870\uC791\uD0A4\uB97C
      \uBC30\uC6B0\uB294 \uC2A4\uD14C\uC774\uC9C0\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000001
    m_Localized: "\uACBD\uB85C\uAC00 \uAEBE\uC5EC \uC788\uC2B5\uB2C8\uB2E4. ALT\uB97C
      \uC138 \uBC88 \uC5F0\uC18D\uC73C\uB85C \uB20C\uB7EC \uC881\uC740 \uACF5\uAC04\uC5D0\uC11C
      \uBC29\uD5A5\uC744 \uBC14\uAFD4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000002
    m_Localized: "ALT\uB97C \uC138 \uBC88 \uC5F0\uC18D\uC73C\uB85C \uB450 \uBC88
      \uC0AC\uC6A9\uD558\uBA74 \uC81C\uC790\uB9AC\uC5D0\uC11C 180\uB3C4 \uB3CC\uC544\uC11C\uB294
      \uD6A8\uACFC\uAC00 \uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000003
    m_Localized: "\uB450 \uAC1C\uC758 \uBAA9\uC801\uC9C0\uC640 Help \uD0C0\uC77C\uC774
      \uC788\uC2B5\uB2C8\uB2E4. \uD78C\uD2B8\uB97C \uCC38\uACE0\uD574 \uB450 \uACF3
      \uBAA8\uB450 \uD074\uB9AC\uC5B4\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000004
    m_Localized: "Help \uD0C0\uC77C\uC774 \uAC00\uC7A5 \uC548\uC804\uD55C \uACBD\uB85C\uB97C
      \uAC00\uB974\uCCD0 \uC90D\uB2C8\uB2E4. \uD78C\uD2B8\uB97C \uBBFF\uACE0 \uBAA9\uC801\uC9C0\uAE4C\uC9C0
      \uB098\uC544\uAC00\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000005
    m_Localized: "\uC8FC\uC758 -- F4 \uD6C4 ALT \uD6C4 F4 \uC21C\uC11C\uB294 \uC989\uC0AC
      \uD328\uD134\uC785\uB2C8\uB2E4. \uB354 \uC548\uC804\uD55C \uBC29\uBC95\uC744
      \uCC3E\uC544\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000006
    m_Localized: "\uCCAB \uBC88\uC9F8 MoveToggle\uC785\uB2C8\uB2E4. \uC815\uD574\uC9C4
      \uD69F\uC218\uB9CC\uD07C \uC774\uB3D9\uD558\uBA74 \uAE38\uC774 \uC5F4\uB9BD\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000007
    m_Localized: "\uB450 \uBAA9\uC801\uC9C0\uC640 MoveToggle. \uC774\uB3D9 \uD69F\uC218\uB97C
      \uC2E0\uC911\uD558\uAC8C \uACC4\uC0B0\uD558\uC138\uC694. \uCD08\uACFC\uD558\uBA74
      \uAE38\uC774 \uB2EB\uD799\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000008
    m_Localized: "MoveToggle\uACFC RotateToggle\uC774 \uD568\uAED8 \uB4F1\uC7A5\uD569\uB2C8\uB2E4.
      \uAC01\uAC01 \uC11C\uB85C \uB2E4\uB978 \uD589\uB3D9\uC744 \uCE74\uC6B4\uD305\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000009
    m_Localized: "RotateToggle\uB9CC\uC774 \uCD9C\uAD6C\uB97C \uC9C0\uD0B5\uB2C8\uB2E4.
      \uD68C\uC804\uD560 \uB54C\uB9C8\uB2E4 \uCE74\uC6B4\uD2B8\uAC00 \uC904\uC5B4\uB4DC\uB2C8
      \uC2E0\uC911\uD788 \uC120\uD0DD\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000010
    m_Localized: "ActionToggle\uC740 \uC774\uB3D9\uACFC \uD68C\uC804\uC744 \uD569\uC0B0\uD569\uB2C8\uB2E4.
      \uCE74\uC6B4\uD2B8\uAC00 \uC18C\uC9C4\uB418\uAE30 \uC804\uC5D0 \uB450 \uBAA9\uC801\uC9C0\uB97C
      \uBAA8\uB450 \uD074\uB9AC\uC5B4\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000011
    m_Localized: "\uB450 Help \uD0C0\uC77C\uC774 RotateToggle\uACFC ActionToggle\uC744
      \uC548\uC804\uD558\uAC8C \uD1B5\uACFC\uD558\uB294 \uBC29\uBC95\uC744 \uC54C\uB824\uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000012
    m_Localized: "\uB450 \uBAA9\uC801\uC9C0, \uB450 \uD1A0\uAE00, \uB450 \uD78C\uD2B8.
      \uB3C4\uC804 \uC21C\uC11C\uAC00 \uC0DD\uC874 \uC5EC\uBD80\uB97C \uACB0\uC815\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000013
    m_Localized: "\uC138 \uAC1C\uC758 \uD78C\uD2B8\uC640 \uC138 \uC885\uB958\uC758
      \uD1A0\uAE00. \uC9C4\uC9DC \uC704\uD611\uC774 \uBB34\uC5C7\uC778\uC9C0 \uD30C\uC545\uD55C
      \uB4A4 \uACBD\uB85C\uB97C \uACC4\uD68D\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000014
    m_Localized: "\uC138 \uAC1C\uC758 RotateToggle\uC774 \uB450 \uBAA9\uC801\uC9C0\uB97C
      \uAC00\uB85C\uB9C9\uC2B5\uB2C8\uB2E4. \uD78C\uD2B8 \uD0C0\uC77C\uC774 \uC815\uD655\uD55C
      \uD0A4 \uC2DC\uD000\uC2A4\uB97C \uC54C\uB824\uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000100
    m_Localized: "\uC5BC\uC74C \uD0C0\uC77C\uC5D0\uC11C\uB294 \uBBF8\uB044\uB7EC\uC9D1\uB2C8\uB2E4.
      Stop \uD0C0\uC77C\uB85C \uC801\uC808\uD55C \uC704\uCE58\uC5D0\uC11C \uBA48\uCD94\uB294
      \uBC29\uBC95\uC744 \uC775\uD788\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000101
    m_Localized: "\uC5BC\uC74C\uACFC ActionToggle\uC774 \uD568\uAED8 \uC788\uC2B5\uB2C8\uB2E4.
      \uC2AC\uB77C\uC774\uB529\uB3C4 \uC774\uB3D9 \uCE74\uC6B4\uD2B8\uC5D0 \uD3EC\uD568\uB429\uB2C8\uB2E4.
      \uBBF8\uB044\uB7EC\uC9C0\uAE30 \uC804\uC5D0 \uACC4\uD68D\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000102
    m_Localized: "\uD154\uB808\uD3EC\uD2B8 \uD0C0\uC77C\uC744 \uBC1F\uC73C\uBA74
      \uC21C\uC2DD\uAC04\uC5D0 \uC774\uB3D9\uD569\uB2C8\uB2E4. \uC5B4\uB514\uC5D0
      \uB098\uD0C0\uB098\uB294\uC9C0 \uD30C\uC545\uD558\uB294 \uAC83\uC774 \uD575\uC2EC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000103
    m_Localized: "\uB450 MoveToggle\uACFC \uD154\uB808\uD3EC\uD2B8. \uC6CC\uD504\uB97C
      \uD65C\uC6A9\uD574 \uD1A0\uAE00\uC774 \uB9C9\uB294 \uAD6C\uC5ED\uC744 \uC6B0\uD68C\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000104
    m_Localized: "\uD154\uB808\uD3EC\uD2B8\uC5D0\uC11C \uB098\uC624\uBA74 \uC5BC\uC74C
      \uC704\uB97C \uBBF8\uB044\uB7EC\uC9D1\uB2C8\uB2E4. \uC62C\uBC14\uB978 \uBC29\uD5A5\uC73C\uB85C
      \uBBF8\uB044\uB7EC\uC838 \uBAA9\uC801\uC9C0\uC5D0 \uB3C4\uB2EC\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000105
    m_Localized: "\uC5EC\uC12F \uAC1C\uC758 Breakable \uD0C0\uC77C\uC774 \uBC1F\uC744
      \uB54C\uB9C8\uB2E4 \uBD80\uC11C\uC9D1\uB2C8\uB2E4. \uC21C\uC11C\uB97C \uC2E0\uC911\uD558\uAC8C
      \uC120\uD0DD\uD558\uC138\uC694. \uB418\uB3CC\uB9B4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000106
    m_Localized: "\uD154\uB808\uD3EC\uD2B8, Breakable, MoveToggle\uC774 \uB4A4\uC11E\uC5EC
      \uC788\uC2B5\uB2C8\uB2E4. \uAF2D \uD544\uC694\uD55C \uC21C\uAC04\uC5D0\uB9CC
      Breakable\uC744 \uBC1F\uC73C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000107
    m_Localized: "\uC5BC\uC74C, \uD154\uB808\uD3EC\uD2B8, Breakable, MoveToggle\uC774
      \uBAA8\uB450 \uB4F1\uC7A5\uD569\uB2C8\uB2E4. \uC5BC\uC74C\uC758 \uAD00\uC131\uC744
      \uD154\uB808\uD3EC\uD2B8\uB85C \uC774\uC5B4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000108
    m_Localized: "\uB124 Breakable, \uB450 MoveToggle, \uD558\uB098\uC758 Help. \uD78C\uD2B8\uC5D0\uB294
      \uC774\uC720\uAC00 \uC788\uC2B5\uB2C8\uB2E4. \uBA3C\uC800 \uC77D\uC73C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000109
    m_Localized: "\uD68C\uC804 \uD0C0\uC77C\uC744 \uBC1F\uC73C\uBA74 \uB9F5 \uC804\uCCB4\uAC00
      90\uB3C4 \uB3CC\uC544\uAC11\uB2C8\uB2E4. \uBAA9\uC801\uC9C0\uB3C4 \uAC19\uC774
      \uC6C0\uC9C1\uC774\uB2C8 \uBE60\uB974\uAC8C \uC7AC\uD30C\uC545\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000110
    m_Localized: "\uB124 \uBC29\uD5A5\uC758 \uD68C\uC804 \uD0C0\uC77C\uACFC RotateToggle.
      \uB450 \uBAA9\uC801\uC9C0\uC5D0 \uB3C4\uB2EC\uD560 \uD68C\uC804 \uBC29\uD5A5\uC744
      \uD30C\uC545\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000111
    m_Localized: "CW180\uACFC CCW180\uC774 \uB9F5\uC744 \uC644\uC804\uD788 \uB4A4\uC9D1\uC2B5\uB2C8\uB2E4.
      \uC138\uACC4\uAC00 180\uB3C4 \uBC18\uC804\uB418\uB294 \uC21C\uAC04\uC744 \uC900\uBE44\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000112
    m_Localized: "\uB124 \uAC1C\uC758 CW90 \uD68C\uC804 \uD0C0\uC77C\uC774 \uC5F0\uC18D
      \uBC1C\uB3D9\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC5B4\uB290 \uD0C0\uC77C\uC744
      \uBC1F\uACE0 \uD53C\uD560\uC9C0 \uACC4\uC0B0\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000113
    m_Localized: "\uD1A0\uAE00\uB4E4\uACFC \uB9F5 \uD68C\uC804\uC774 \uBAA8\uB4E0
      \uC785\uB825\uC5D0 \uBC18\uC751\uD569\uB2C8\uB2E4. \uC6C0\uC9C1\uC774\uAE30
      \uC804\uC5D0 \uC138 \uC218 \uC55E\uC744 \uB0B4\uB2E4\uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000114
    m_Localized: "\uB124 \uD154\uB808\uD3EC\uD2B8\uC640 \uB124 \uD68C\uC804\uC774
      \uB9CC\uB4E0 \uB300\uADDC\uBAA8 \uBBF8\uB85C. \uD154\uB808\uD3EC\uD2B8\uB85C
      \uC6D0\uCE58 \uC54A\uB294 \uD68C\uC804\uC744 \uAC74\uB108\uB6F0\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3000000000200
    m_Localized: "[3-1 \uC2A4\uD14C\uC774\uC9C0 \uC124\uBA85]"
